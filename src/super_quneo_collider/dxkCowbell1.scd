// SPEC §9.9 import, reshaped per §9.9.2. gesture: continuous
SynthDef("dxkCowbell1", { arg out=0, amp=0.3, basefreq=540, pan=0.0, gate=1, fade=1;
  var snd, stopFade, fadeEnv;
    
    var sig, env;

    sig = Pulse.ar( basefreq * [ 1, 1.5085 ], [ 0.565, 0.445 ], [ 0.4, 0.6 ] ).distort;
    env = EnvGen.ar(
            Env(
                [ 0, 0.05, 1, 0.1, 0 ], [ 0.003, 0.002, 0.05, 0.5 ], [2, -4, -4, -4]
            ),
        gate: gate,
        timeScale: [ 1.0, 1.5 ],
        doneAction: 0
        );
    sig = Mix( sig * env );
    sig = BPF.ar( sig, basefreq * 2, 1.808 );
  snd = Pan2.ar( sig, pan, amp );
  stopFade = EnvGen.kr(Env.asr(0.01, 1, 3), gate, doneAction: 0);
  fadeEnv = EnvGen.kr(Env.new([0, 1, 1, 0], [0.01, 9, 3], 'lin'), 1, doneAction: 0);
  snd = snd * stopFade * Select.kr(fade > 0, [1, fadeEnv]);
  DetectSilence.ar(snd, 0.0001, 0.5, doneAction: 2);
  Out.ar(out, snd);
});
